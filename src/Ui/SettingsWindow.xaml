<Window x:Class="CpuGlassMonitor.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="显示设置"
        Width="760" Height="592" MinWidth="680" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="#12161C" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFont}" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="SettingCheckBox" TargetType="CheckBox" BasedOn="{StaticResource GlassCheckBox}">
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#26FFFFFF" BorderThickness="1" Background="#12161C">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid x:Name="TitleBar" Background="Transparent" Margin="18,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="显示设置" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="AdminBadge" Text="管理员" FontSize="10" Margin="10,0,0,0"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="Close_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>

            <!-- 主体 -->
            <Grid Grid.Row="1" Margin="18,4,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：参数选择 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="监控参数（可多选）" Style="{StaticResource SectionTitle}" Margin="0,2,0,8" />

                    <Border Grid.Row="1" CornerRadius="9" Background="#0EFFFFFF" BorderBrush="#1FFFFFFF"
                            BorderThickness="1" Height="32" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索参数，如 温度 / 电压 / GPU"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <ListBox x:Name="MetricListBox" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True" SelectionMode="Single">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="4,9,0,3" FontSize="10.4"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="7" Padding="8,5" Margin="0,1"
                                                    Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource GlassCheckBox}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="12.2"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="10.2"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock x:Name="SelectedCount" Text="已选 0 项" Style="{StaticResource FieldLabel}"
                                   FontSize="11" />
                        <Button Content="推荐" Style="{StaticResource GhostButton}" Padding="9,3" Margin="12,0,0,0"
                                FontSize="11" Click="ApplyRecommended_Click" />
                        <Button Content="全不选" Style="{StaticResource GhostButton}" Padding="9,3" Margin="6,0,0,0"
                                FontSize="11" Click="ClearAll_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="#1AFFFFFF" Margin="0,4,0,4" />

                <!-- 右：外观与行为 -->
                <ScrollViewer x:Name="OptionsScroll" Grid.Column="2" Margin="18,0,2,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}" Margin="0,2,0,6" />

                        <TextBlock Text="排列方式" Style="{StaticResource FieldLabel}" Margin="0,2,0,6" />
                        <StackPanel x:Name="LayoutPanel" Orientation="Horizontal" Margin="0,0,0,12" />

                        <Grid>
                            <TextBlock Text="玻璃浓度" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="TintValueText" Style="{StaticResource FieldValue}" />
                        </Grid>
                        <Slider x:Name="TintSlider" Style="{StaticResource GlassSlider}" Minimum="0.05" Maximum="0.92"
                                SmallChange="0.01" LargeChange="0.05" Margin="0,4,0,10"
                                ValueChanged="TintSlider_ValueChanged" />

                        <Grid>
                            <TextBlock Text="面板透明度" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="OpacityValueText" Style="{StaticResource FieldValue}" />
                        </Grid>
                        <Slider x:Name="OpacitySlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="92"
                                SmallChange="1" LargeChange="5" Margin="0,4,0,4"
                                ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock Text="数值越大越能看穿面板，直接露出背后的桌面/游戏；文字与曲线不跟着变淡。0 附近是磨砂玻璃，越大越接近整块消失。"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.2"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />

                        <Grid>
                            <TextBlock Text="高光强度" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="OverlayValueText" Style="{StaticResource FieldValue}" />
                        </Grid>
                        <Slider x:Name="OverlaySlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="1"
                                SmallChange="0.02" LargeChange="0.1" Margin="0,4,0,10"
                                ValueChanged="OverlaySlider_ValueChanged" />

                        <Grid>
                            <TextBlock Text="字号缩放" Style="{StaticResource FieldLabel}" />
                            <TextBlock x:Name="FontValueText" Style="{StaticResource FieldValue}" />
                        </Grid>
                        <Slider x:Name="FontSlider" Style="{StaticResource GlassSlider}" Minimum="0.8" Maximum="1.6"
                                SmallChange="0.02" LargeChange="0.1" Margin="0,4,0,10"
                                ValueChanged="FontSlider_ValueChanged" />

                        <TextBlock Text="强调色" Style="{StaticResource FieldLabel}" Margin="0,2,0,6" />
                        <StackPanel x:Name="AccentPanel" Orientation="Horizontal" />

                        <CheckBox x:Name="ChkSpark" Content="显示走势曲线" Style="{StaticResource SettingCheckBox}" />
                        <CheckBox x:Name="ChkColorize" Content="数值按温度/负载阈值变色" Style="{StaticResource SettingCheckBox}" />

                        <TextBlock Text="刷新间隔" Style="{StaticResource SectionTitle}" />
                        <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" />

                        <TextBlock Text="行为" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="ChkTopmost" Content="窗口置顶" Style="{StaticResource SettingCheckBox}" />
                        <CheckBox x:Name="ChkLock" Content="锁定位置（禁止拖动）" Style="{StaticResource SettingCheckBox}" />
                        <CheckBox x:Name="ChkClickThrough" Content="鼠标穿透（点击不拦截鼠标）" Style="{StaticResource SettingCheckBox}" />
                        <CheckBox x:Name="ChkAutoStart" Content="开机自启（计划任务，登录不弹 UAC）" Style="{StaticResource SettingCheckBox}" />
                        <CheckBox x:Name="ChkElevate" Content="启动时请求管理员权限（读取 CPU 温度/频率/电压）"
                                  Style="{StaticResource SettingCheckBox}" />

                        <TextBlock Text="数据" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="ChkShowAll" Content="显示全部传感器（含线程负载、距离 TjMax 等杂项）"
                                  Style="{StaticResource SettingCheckBox}" Checked="ShowAll_Changed" Unchecked="ShowAll_Changed" />
                        <TextBlock Text="提示：CPU 温度、频率与核心电压来自内核驱动，必须以管理员身份运行才能读取。"
                                   Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10.5"
                                   TextWrapping="Wrap" Margin="0,12,0,10" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底部 -->
            <Grid Grid.Row="2" Margin="18,0,18,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button Content="恢复默认" Style="{StaticResource GhostButton}" Click="Reset_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Padding="18,6" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
