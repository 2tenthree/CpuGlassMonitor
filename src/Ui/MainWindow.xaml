<Window x:Class="CpuGlassMonitor.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CpuGlassMonitor.Ui"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CPU 玻璃监控"
        Width="304" SizeToContent="Height" MinWidth="236" MaxWidth="640"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="-1"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <sys:Double x:Key="LabelSize">11.5</sys:Double>
        <sys:Double x:Key="ValueSize">16</sys:Double>
        <sys:Double x:Key="UnitSize">9.5</sys:Double>
        <sys:Double x:Key="FooterSize">9.5</sys:Double>
        <sys:Double x:Key="RowHeight">22</sys:Double>
        <GridLength x:Key="ValueColumnWidth">48</GridLength>
        <GridLength x:Key="UnitColumnWidth">24</GridLength>
        <sys:Double x:Key="SparkWidth">46</sys:Double>
        <sys:Double x:Key="SparkWidthH">30</sys:Double>
        <sys:Double x:Key="SparkHeight">13</sys:Double>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="MetricRowTemplate" DataType="{x:Type ui:MetricRow}">
            <Grid Height="{DynamicResource RowHeight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{DynamicResource ValueColumnWidth}" />
                    <ColumnDefinition Width="{DynamicResource UnitColumnWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Label}"
                           FontSize="{DynamicResource LabelSize}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0" />

                <TextBlock Grid.Column="1"
                           Text="{Binding ValueText}"
                           FontFamily="{DynamicResource NumFont}"
                           FontSize="{DynamicResource ValueSize}"
                           FontWeight="SemiBold"
                           Foreground="{Binding ValueBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />

                <TextBlock Grid.Column="2"
                           Text="{Binding Unit}"
                           FontSize="{DynamicResource UnitSize}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="4,0,0,1" />

                <ui:Sparkline Grid.Column="3"
                              Width="{DynamicResource SparkWidth}"
                              Height="{DynamicResource SparkHeight}"
                              Values="{Binding History}"
                              MinValue="{Binding SparkMin}"
                              MaxValue="{Binding SparkMax}"
                              Accent="{DynamicResource AccentColor}"
                              VerticalAlignment="Center" Margin="6,0,0,0"
                              Visibility="{Binding ShowSpark, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- 横向排列用的紧凑模板：标签 值 单位 挤在一行 -->
        <DataTemplate x:Key="MetricRowTemplateH" DataType="{x:Type ui:MetricRow}">
            <StackPanel Orientation="Horizontal" Height="{DynamicResource RowHeight}" Margin="0,0,14,0">
                <TextBlock Text="{Binding Label}"
                           FontSize="{DynamicResource LabelSize}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,1" />
                <TextBlock Text="{Binding ValueText}"
                           FontFamily="{DynamicResource NumFont}"
                           FontSize="{DynamicResource ValueSize}"
                           FontWeight="SemiBold"
                           Foreground="{Binding ValueBrush}"
                           VerticalAlignment="Center"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="{Binding Unit}"
                           FontSize="{DynamicResource UnitSize}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" Margin="3,0,0,1" />
                <ui:Sparkline Width="{DynamicResource SparkWidthH}"
                              Height="{DynamicResource SparkHeight}"
                              Values="{Binding History}"
                              MinValue="{Binding SparkMin}"
                              MaxValue="{Binding SparkMax}"
                              Accent="{DynamicResource AccentColor}"
                              VerticalAlignment="Center" Margin="7,0,0,0"
                              Visibility="{Binding ShowSpark, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="Menu">
            <MenuItem Header="显示设置…" InputGestureText="双击面板" Click="OpenSettings_Click" />
            <Separator />
            <MenuItem x:Name="MenuTopmost" Header="窗口置顶" IsCheckable="True" Click="MenuTopmost_Click" />
            <MenuItem x:Name="MenuLocked" Header="锁定位置" IsCheckable="True" Click="MenuLocked_Click" />
            <MenuItem x:Name="MenuClickThrough" Header="鼠标穿透" IsCheckable="True" Click="MenuClickThrough_Click" />
            <MenuItem x:Name="MenuSpark" Header="走势曲线" IsCheckable="True" Click="MenuSpark_Click" />
            <MenuItem x:Name="MenuHorizontal" Header="横向排列" IsCheckable="True" Click="MenuHorizontal_Click" />
            <Separator />
            <MenuItem x:Name="MenuAutoStart" Header="开机自启" IsCheckable="True" Click="MenuAutoStart_Click" />
            <Separator />
            <MenuItem Header="隐藏面板" Click="HideToTray_Click" />
            <MenuItem Header="退出" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="Root" Background="Transparent">
        <!-- 玻璃底色蒙版：透明度由「面板透明度」控制，文字画在它上面所以始终清晰 -->
        <Border x:Name="Scrim" CornerRadius="13" Background="#E610131A" />
        <Border x:Name="Card" CornerRadius="13" BorderThickness="1"
                BorderBrush="#2BFFFFFF" Background="#08FFFFFF" SnapsToDevicePixels="True">
            <Grid x:Name="CardInner" Margin="15,11,14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 指标列表（竖排 / 横排两种模板，切换显示） -->
                <ItemsControl x:Name="MetricList" Grid.Row="0" Margin="0,1,0,0"
                              ItemTemplate="{StaticResource MetricRowTemplate}" />

                <ItemsControl x:Name="MetricListH" Grid.Row="0" Margin="0,1,0,0" Visibility="Collapsed"
                              ItemTemplate="{StaticResource MetricRowTemplateH}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 用 WrapPanel：参数选得多、宽度顶到屏幕边缘时自动折到第二行 -->
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 提示信息 -->
                <TextBlock x:Name="HintText" Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                           FontSize="{DynamicResource FooterSize}" Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="Collapsed" LineHeight="14" />
            </Grid>
        </Border>
    </Grid>
</Window>
